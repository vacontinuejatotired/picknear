# ==============================================
# picknear Docker Compose 环境变量
# ==============================================
# 复制此文件为 .env，填入真实值后执行:
#   cp .env.example .env   # Linux/macOS
#   copy .env.example .env  # Windows
#   docker compose up -d
# ==============================================

# ---- MySQL ----
DB_PASSWORD=281458

# ---- 阿里云 OSS（图片上传）----
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret

# ---- 通义千问 AI API ----
DASHSCOPE_API_KEY=your-dashscope-api-key

# ---- Langfuse 云观测（⚠️ 必填，缺失 app 启动报 Could not resolve placeholder）----
# 从 Langfuse 云控制台获取：项目设置 → 公钥/私钥
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=your-pk-lf-xxx
LANGFUSE_SECRET_KEY=your-sk-lf-xxx
# BASIC_AUTH = base64("公钥:私钥")
LANGFUSE_BASIC_AUTH=your-base64(pk:sk)

# ---- 日志级别（可选，缺省 INFO）----
# LOG_LEVEL_HMDP=INFO
# LOG_LEVEL_AGENT=INFO
# LOG_LEVEL_AGENT_GUARD=INFO
# LOG_LEVEL_AGENT_TOOL=INFO
# LOG_LEVEL_PROMPTHOOK=INFO
# LOG_LEVEL_INTERCEPTOR=INFO
